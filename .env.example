# StudentOS Environment Configuration

# Backend
PROJECT_NAME="StudentOS"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-secret-key-in-production-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Database: Use SQLite locally or PostgreSQL
DATABASE_URL="sqlite:///./studentos.db"
# For PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studentos"

# Frontend Origin for CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Optional Local LLM Assistant (Ollama)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:latest"
ENABLE_OLLAMA=false

# Machine Learning Artifacts Directory
ML_ARTIFACTS_DIR="./artifacts"
